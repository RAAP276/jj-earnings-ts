# =============================================================================
# Project-level R configuration.
#
# This file is sourced automatically every time the project is opened in
# RStudio/Positron. It configures reproducible defaults and keeps the
# console clean.
# =============================================================================

# Use a reproducible CRAN mirror.
options(repos = c(CRAN = "https://cloud.r-project.org"))

# Suppress tidyverse startup messages.
options(tidyverse.quiet = TRUE)

# Do NOT auto-convert character columns to factors (R >= 4.0 default, but
# explicit here for reproducibility).
options(stringsAsFactors = FALSE)

# Increase printed tibble width so long outputs do not wrap unexpectedly.
options(width = 100)

# Disable scientific notation for large numbers (cleaner console output).
options(scipen = 999)